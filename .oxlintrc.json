{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  "plugins": [
    "react",
    "typescript",
    "oxc"
  ],
  "ignorePatterns": [
    "docs/patterns/**"
  ],
  "rules": {
    "react/rules-of-hooks": "error",
    "react/only-export-components": "off"
  },
  "overrides": [
    {
      "files": [
        "**/*.test.ts"
      ],
      "rules": {
        "react/no-children-prop": "off"
      }
    }
  ]
}
