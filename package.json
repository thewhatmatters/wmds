{
  "name": "@whatmatters/wmds",
  "description": "WhatMatters Design System — Tailwind v4 theme + Storybook",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "files": [
    "dist",
    "README.md",
    "CONSUMING.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./colors.css": "./dist/colors.css",
    "./motion.css": "./dist/motion.css",
    "./typography.css": "./dist/typography.css",
    "./stateColors.css": "./dist/stateColors.css",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-package.mjs",
    "build:app": "tsc -b && vite build",
    "prepare": "npm run build",
    "lint": "oxlint",
    "prepublishOnly": "npm run build",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:unit": "vitest --project unit run",
    "test:storybook": "vitest --project storybook run",
    "validate:manifest": "node scripts/validate-manifest.mjs"
  },
  "peerDependencies": {
    "motion": "^13.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "latest",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "latest",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "oxlint": "^1.75.0",
    "playwright": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "latest"
  },
  "dependencies": {
    "@nivo/line": "^0.99.0"
  }
}
