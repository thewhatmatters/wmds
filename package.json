{
  "name": "@thewhatmatters/wmds",
  "description": "WhatMatters Design System — React components, Tailwind v4 theme, and Storybook patterns",
  "version": "0.4.8",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/thewhatmatters/wmds.git"
  },
  "homepage": "https://github.com/thewhatmatters/wmds#readme",
  "bugs": {
    "url": "https://github.com/thewhatmatters/wmds/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "wmds-check": "bin/wmds-check.mjs"
  },
  "files": [
    "dist",
    "bin",
    "docs/README.md",
    "docs/consumer-agents.md",
    "docs/components.md",
    "docs/component-contracts.md",
    "docs/exports.json",
    "docs/patterns",
    "public/rive/interactive-icon-set.riv",
    "public/rive/CREDITS.md",
    "README.md",
    "CONSUMING.md",
    "CHANGELOG.md"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./styles.css": "./dist/styles.css",
    "./theme.css": "./dist/theme.css",
    "./colors.css": "./dist/colors.css",
    "./motion.css": "./dist/motion.css",
    "./typography.css": "./dist/typography.css",
    "./stateColors.css": "./dist/stateColors.css",
    "./grid.css": "./dist/grid.css",
    "./shape.css": "./dist/shape.css",
    "./scrollFade.css": "./dist/scrollFade.css",
    "./docs/*": "./docs/*",
    "./CHANGELOG.md": "./CHANGELOG.md",
    "./package.json": "./package.json"
  },
  "sideEffects": [
    "**/*.css"
  ],
  "scripts": {
    "dev": "vite",
    "build": "node scripts/build-package.mjs",
    "build:app": "tsc -b && vite build",
    "prepare": "npm run build",
    "lint": "oxlint",
    "preview": "vite preview",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test:unit": "vitest --project unit run",
    "test:storybook": "vitest --project storybook run",
    "test:interactions": "vitest --project storybook run",
    "validate:composition": "vitest --project unit run src/lib/compositionAudit.test.ts",
    "validate:manifest": "node scripts/validate-manifest.mjs",
    "validate:case": "node scripts/check-case-collisions.mjs",
    "typecheck": "tsc -b",
    "check:pack": "node scripts/check-pack.mjs",
    "check:changelog": "node scripts/check-changelog.mjs",
    "docs:generate": "node scripts/generate-package-docs.mjs",
    "check:docs": "node scripts/generate-package-docs.mjs --check",
    "check:show-code": "node scripts/check-show-code.mjs"
  },
  "peerDependencies": {
    "@visx/visx": "^4.0.0",
    "lucide-react": "^1.33.0",
    "motion": "^13.0.0",
    "react": "^18.0.0 || ^19.0.0",
    "react-dom": "^18.0.0 || ^19.0.0"
  },
  "devDependencies": {
    "@chromatic-com/storybook": "^5.3.0",
    "@fontsource-variable/geist": "^5.2.8",
    "@fontsource-variable/geist-mono": "^5.2.8",
    "@storybook/addon-a11y": "^10.5.10",
    "@storybook/addon-docs": "^10.5.10",
    "@storybook/addon-mcp": "^0.7.0",
    "@storybook/addon-vitest": "^10.5.10",
    "@storybook/react-vite": "^10.5.10",
    "@tailwindcss/cli": "^4.3.3",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@visx/visx": "^4.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "@vitest/browser-playwright": "^4.1.11",
    "@vitest/coverage-v8": "^4.1.11",
    "happy-dom": "^20.14.5",
    "lucide-react": "^1.33.0",
    "motion": "^13.1.1",
    "oxlint": "^1.75.0",
    "playwright": "^1.62.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "storybook": "^10.5.10",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  },
  "dependencies": {
    "@base-ui/react": "^1.8.0",
    "@gsap/react": "^2.1.2",
    "@rive-app/react-canvas": "^4.35.0",
    "gsap": "^3.15.0"
  }
}
